# Copy to .env for local runs. Never commit the real .env file.
# In the cloud workspace, set these as environment variables instead.

# Claude (planning, writing, checking)
ANTHROPIC_API_KEY=
# OpenAI (voices)
OPENAI_API_KEY=

# Supabase (from Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key, base64. Encrypts the listener profile. Create with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTEXT_ENCRYPTION_KEY=

# Podcast search
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
